# NixOS only -- on a normal FHS distro this file is unnecessary; `uv sync`
# alone reproduces a working environment.
#
# numpy / scipy / lightgbm link libstdc++.so.6, which Nix deliberately keeps off
# the default loader path. The previous revision hardcoded a store path with a
# specific gcc hash, which silently broke on every nixos-rebuild that updated
# gcc; resolve the current path instead so this survives system upgrades.
if command -v nix >/dev/null 2>&1; then
  GCC_LIB="$(nix path-info nixpkgs#gcc.cc.lib 2>/dev/null)"
  Z_LIB="$(nix path-info nixpkgs#zlib 2>/dev/null)"
  if [ -n "$GCC_LIB" ] && [ -n "$Z_LIB" ]; then
    export LD_LIBRARY_PATH="$GCC_LIB/lib:$Z_LIB/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  else
    echo "warning: could not resolve libstdc++ via nix; imports may fail" >&2
  fi
fi
