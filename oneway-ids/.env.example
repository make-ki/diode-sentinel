# Environment — Diode Sentinel

Copy to `.env` and adjust. Everything here is optional for local replay; the
values only matter for the live AF_PACKET ingest path.

# --- ingest ---
# Source of traffic. `pcap` replays a file, `afpacket` reads a live socket,
# `pipe` reads a FIFO/pcap-stream. The demo runs on `pcap`.
DIODE_SOURCE=pcap

# Path to the capture when DIODE_SOURCE=pcap.
DIODE_PCAP=traffic.pcap

# Live interface for DIODE_SOURCE=afpacket. Requires CAP_NET_RAW.
DIODE_IFACE=enp7s0

# Direction the sensor observes. The whole point of the project: only one
# direction is ever visible, so detectors must not assume a reply exists.
DIODE_DIRECTION=client

# --- Zeek (Tier-1 protocol dissection layer) ---
# Zeek 7.2.2 binary. On NixOS it lands in the store; point at it directly.
ZEEK_BIN=/nix/store/z0vsr4g58nfw5rzw2zl1mf4rpc1z6c9k-zeek-7.2.2/bin/zeek

# One-way profile. Contains the redefs that keep a diode feed analysable.
ZEEK_PROFILE=zeek/oneway.zeek

# Accept frames with invalid checksums. A diode's receive NIC offloads
# checksum computation, so captured frames carry bogus values and Zeek
# discards them otherwise. Set to 1 to pass -C.
ZEEK_IGNORE_CHECKSUMS=1

# Idle expiry for flows that never close (a one-way feed never sees a FIN).
ZEEK_IDLE_TIMEOUT=60

# --- detection ---
# Detection window (seconds of packet time).
DIODE_WINDOW=10.0

# Flow idle timeout before the assembler emits a flow record.
DIODE_IDLE_TIMEOUT=2.0

# Baseline window for the TLS/JA4 fingerprint inventory.
DIODE_BASELINE_SECONDS=180.0

# --- ML tier (CPU-only by design) ---
# LightGBM / XGBoost / sklearn only. No GPU required: the whole tier trains
# in seconds on 12 cores. Do not enable the deep-model extras.
DIODE_ML_ENABLED=1
DIODE_MODELS_567=

# --- observability ---
DIODE_METRICS_PORT=9410
DIODE_PROMETHEUS_URL=http://localhost:9090

# --- NixOS loader path ---
# numpy/scipy/lightgbm need libstdc++ and zlib. On NixOS these are not on the
# default loader path, so export this before running anything. `nix develop`
# does it for you; this is the no-flake fallback (see .env-ml).
LD_LIBRARY_PATH=/run/opengl-driver/lib:$(nix path-info nixpkgs#gcc.cc.lib)/lib:$(nix path-info nixpkgs#zlib)/lib
