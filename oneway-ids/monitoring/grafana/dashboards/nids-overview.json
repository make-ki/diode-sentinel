{
  "uid": "nids-overview",
  "title": "NIDS Overview",
  "description": "One-way NIDS sensor: ingest health, detection mix and alert flow. Requires the sensor exporter (run.py --metrics-port 9100).",
  "tags": ["nids", "one-way", "diode"],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "links": [
    {
      "title": "SOC dashboard (:8600)",
      "type": "link",
      "url": "http://localhost:8600",
      "targetBlank": true
    },
    {
      "title": "Prometheus (:9090)",
      "type": "link",
      "url": "http://localhost:9090",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Sensor",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"nids\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "title": "Alerts (5m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 4, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nids_alerts_total[5m]))",
          "legendFormat": "alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "title": "Critical (5m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nids_alerts_total{severity=\"critical\"}[5m]))",
          "legendFormat": "critical"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "title": "High (5m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nids_alerts_total{severity=\"high\"}[5m]))",
          "legendFormat": "high"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "title": "Kernel drops (5m)",
      "type": "stat",
      "description": "Frames lost in the kernel ring buffer before analysis. On a one-way feed this traffic is gone for good -- must stay zero.",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nids_kernel_dropped_total[5m]))",
          "legendFormat": "dropped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 10,
      "title": "Alerts by threat class (rate, 5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (threat_class) (rate(nids_alerts_total[5m]))",
          "legendFormat": "{{threat_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "title": "Alerts by severity (rate, 5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (rate(nids_alerts_total[5m]))",
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 20,
      "title": "Ingest (packets/s, flows/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nids_packets_processed_total[1m]))",
          "legendFormat": "packets/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nids_flows_closed_total[1m]))",
          "legendFormat": "flows closed/s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(nids_frames_sampled_out_total[1m]))",
          "legendFormat": "sampled out/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 21,
      "title": "Active flows and windows",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (nids_flows_active)",
          "legendFormat": "active {{kind}} flows"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nids_windows_flushed_total[1m]))",
          "legendFormat": "windows flushed/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 30,
      "title": "Deep inspection (DNS qnames/s, ClientHellos/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nids_dns_queries_total[1m]))",
          "legendFormat": "DNS qnames/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nids_clienthellos_parsed_total[1m]))",
          "legendFormat": "ClientHellos/s (TCP+QUIC)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 31,
      "title": "Tier-2 attribution and allowlist",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "nids-prom" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nids_ml_alerts_total[5m]))",
          "legendFormat": "LightGBM flow verdicts/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nids_cnn_alerts_total[5m]))",
          "legendFormat": "DGA CNN confirmations/s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(nids_alerts_suppressed_total[5m]))",
          "legendFormat": "allowlisted/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
